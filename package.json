{
  "name": "opc-ai-lite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "learning:shell:accept": "tsx scripts/accept-unified-lesson-shell.ts",
    "learning:runtime:track01-phase1": "tsx scripts/provision-track01-phase1-runtime.ts",
    "learning:runtime:accept:track01-phase1": "tsx scripts/accept-track01-phase1-runtime.ts",
    "learning:runtime:accept:track01-phase1-parity": "tsx scripts/accept-track01-phase1-interaction-parity.ts",
    "learning:formal-registry:check": "tsx scripts/validate-formal-lesson-runtime-registry.ts",
    "learning:runtime-perf003:check": "tsx scripts/validate-course-runtime-perf003.ts",
    "learning:sidebar-ux:check": "tsx scripts/validate-course-sidebar-ux.ts",
    "learning:track01-baseline:check": "tsx scripts/validate-track01-current-baseline.ts",
    "learning:track02-context:check": "tsx scripts/validate-track02-curriculum-context.ts",
    "learning:track02-path-access:check": "tsx scripts/validate-track02-learning-path-access.ts",
    "access:membership-policy:check": "tsx scripts/validate-membership-benefit-policy.ts",
    "practice:ia:check": "tsx scripts/validate-practice-information-architecture.ts",
    "learning:course-interaction:check": "tsx scripts/validate-course-interaction-architecture.ts",
    "learning:course-build-entry:check": "tsx scripts/validate-course-build-entry.ts",
    "learning:course-production-workflow:check": "tsx scripts/validate-course-production-workflow.ts",
    "learning:course-governance:check": "tsx scripts/validate-course-governance.ts",
    "scripts:current:check": "tsx scripts/validate-script-entrypoints.ts",
    "learning:course-current-state:check": "tsx scripts/validate-course-current-state.ts",
    "course-builder:check": "tsx scripts/validate-course-builder.ts",
    "learning:check-types:accept": "tsx scripts/accept-formal-check-types-runtime.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/server/db/seed.ts",
    "jobs:drain:learning-behavior": "node --env-file=.env.local --conditions=react-server --import tsx scripts/drain-learning-behavior-jobs.ts",
    "access:resume:accept": "node --conditions=react-server --import tsx scripts/accept-access-resume.ts",
    "learning:runtime:track01-t11-t20": "tsx scripts/provision-track01-t11-t20-runtime.ts --apply --confirm=TRACK01-T11-T20-RUNTIME-001",
    "learning:runtime:accept:track01-t11-t20": "tsx scripts/accept-track01-t11-t20-runtime.ts --run --confirm=TRACK01-T11-T20-RUNTIME-002 --base-url=http://127.0.0.1:3110",
    "learning:track02-batch-a:runtime-check": "tsx scripts/validate-track02-batch-a-runtime.ts",
    "learning:runtime:track02-batch-a": "tsx scripts/provision-track02-batch-a-runtime.ts --apply --confirm=TRACK02-BATCH-A-RUNTIME-001",
    "learning:runtime:accept:track02-batch-a": "node --conditions=react-server --import tsx scripts/accept-track02-batch-a-runtime.ts",
    "learning:runtime:track02-batch-b": "tsx scripts/provision-track02-batch-b-runtime.ts --apply --confirm=TRACK02-BATCH-B-RUNTIME-001",
    "learning:runtime:accept:track02-batch-b": "node --conditions=react-server --import tsx scripts/accept-track02-batch-b-runtime.ts",
    "learning:runtime:track02-batch-c": "tsx scripts/provision-track02-batch-c-runtime.ts --apply --confirm=TRACK02-BATCH-C-RUNTIME-001",
    "learning:runtime:accept:track02-batch-c": "node --conditions=react-server --import tsx scripts/accept-track02-batch-c-runtime.ts",
    "learning:runtime:track02-batch-d": "tsx scripts/provision-track02-batch-d-runtime.ts --apply --confirm=TRACK02-BATCH-D-RUNTIME-001",
    "learning:runtime:accept:track02-batch-d": "node --conditions=react-server --import tsx scripts/accept-track02-batch-d-runtime.ts",
    "learning:track02-batch-d:formal-check": "tsx scripts/validate-track02-batch-d-registration.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "15.5.25",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "5.8.3"
  }
}
