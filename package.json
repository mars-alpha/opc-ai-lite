{
  "name": "opc-ai-lite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "learning:shell:accept": "tsx scripts/accept-unified-lesson-shell.ts",
    "learning:formal-registry:check": "tsx scripts/validate-formal-lesson-runtime-registry.ts",
    "learning:sidebar-ux:check": "tsx scripts/validate-course-sidebar-ux.ts",
    "access:membership-policy:check": "tsx scripts/validate-membership-benefit-policy.ts",
    "practice:ia:check": "tsx scripts/validate-practice-information-architecture.ts",
    "learning:course-interaction:check": "tsx scripts/validate-course-interaction-architecture.ts",
    "learning:course-build-entry:check": "tsx scripts/validate-course-build-entry.ts",
    "learning:course-production-workflow:check": "tsx scripts/validate-course-production-workflow.ts",
    "learning:course-governance:check": "tsx scripts/validate-course-governance.ts",
    "scripts:current:check": "tsx scripts/validate-script-entrypoints.ts",
    "learning:course-current-state:check": "tsx scripts/validate-course-current-state.ts",
    "course-builder:check": "tsx scripts/validate-course-builder.ts",
    "learning:check-types:accept": "tsx scripts/accept-formal-check-types-runtime.ts",
    "db:generate": "drizzle-kit generate",
    "db:target:check": "tsx scripts/validate-database-target.ts",
    "db:target:contract:check": "tsx scripts/validate-database-target-contract.ts",
    "db:migrate": "tsx scripts/migrate-database-safe.ts",
    "db:dev:app-role:provision": "tsx scripts/provision-development-app-role.ts",
    "db:seed": "tsx lib/server/db/seed.ts",
    "jobs:drain:learning-behavior": "node --env-file=.env.local --conditions=react-server --import tsx scripts/drain-learning-behavior-jobs.ts",
    "access:resume:accept": "node --conditions=react-server --import tsx scripts/accept-access-resume.ts",
    "governance:repository:check": "tsx scripts/validate-repository-governance.ts",
    "governance:development:check": "tsx scripts/validate-development-governance.ts",
    "admin:shell-dashboard:check": "tsx scripts/validate-admin-shell-dashboard.ts",
    "admin:users-entitlements:check": "tsx scripts/validate-admin-users-entitlements.ts",
    "admin:role:check": "tsx scripts/validate-admin-role.ts",
    "content:workbench:contract:check": "tsx scripts/validate-content-workbench-contract.ts",
    "content:workbench:accept": "tsx scripts/accept-content-workbench.ts",
    "content:workbench:db:accept": "tsx scripts/accept-content-workbench-db.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "15.5.25",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "5.8.3"
  }
}
